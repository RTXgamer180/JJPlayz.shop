
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PRIMAL RUSH - Gorilla VR</title>

<script src="https://aframe.io/releases/1.7.1/aframe.min.js"></script>

<style>
body { margin:0; }
#title {
 position:fixed;
 top:12px;
 left:50%;
 transform:translateX(-50%);
 z-index:10;
 color:white;
 font-family:Arial;
 font-weight:bold;
 font-size:22px;
 text-shadow:2px 2px 5px black;
 pointer-events:none;
}
</style>
</head>

<body>

<div id="title">🦍 PRIMAL RUSH</div>

<script>

// ========================================
// GORILLA LOCOMOTION
// ========================================

AFRAME.registerComponent('gorilla-locomotion', {
 schema: {
  leftHand:{type:'selector',default:'#left-hand'},
  rightHand:{type:'selector',default:'#right-hand'},
  gravity:{type:'number',default:-9.8},
  jumpMultiplier:{type:'number',default:1.3},
  maxSpeed:{type:'number',default:12},
  handRadius:{type:'number',default:0.12}
 },

 init:function() {
  this.velocity=new THREE.Vector3();
  this.rigPos=this.el.object3D.position;
  this.colliders=[];

  this.hands=[
   {el:this.data.leftHand,prevPos:new THREE.Vector3(),currPos:new THREE.Vector3(),initialized:false},
   {el:this.data.rightHand,prevPos:new THREE.Vector3(),currPos:new THREE.Vector3(),initialized:false}
  ];

  this.el.sceneEl.addEventListener('loaded',()=>{
   document.querySelectorAll('.collidable').forEach(el=>{
    el.object3D.updateMatrixWorld(true);
    this.colliders.push(new THREE.Box3().setFromObject(el.object3D));
   });
  });
 },

 tick:function(time,timeDelta) {
  const dt=Math.min(timeDelta/1000,0.05);
  if(dt<=0) return;

  let isPushing=false;
  const pushDisplacement=new THREE.Vector3();

  this.hands.forEach(hand=>{
   if(!hand.el) return;

   hand.el.object3D.getWorldPosition(hand.currPos);

   if(!hand.initialized) {
    hand.prevPos.copy(hand.currPos);
    hand.initialized=true;
    return;
   }

   const sphere=new THREE.Sphere(hand.currPos,this.data.handRadius);
   let colliding=false;

   for(let i=0;i<this.colliders.length;i++) {
    if(this.colliders[i].intersectsSphere(sphere)) {
     colliding=true;
     break;
    }
   }

   if(colliding) {
    const delta=new THREE.Vector3().subVectors(
     hand.currPos,hand.prevPos
    );
    pushDisplacement.sub(delta);
    isPushing=true;
   }

   hand.prevPos.copy(hand.currPos);
  });

  if(isPushing) {
   this.rigPos.add(pushDisplacement);

   this.velocity.copy(pushDisplacement)
    .divideScalar(dt)
    .multiplyScalar(this.data.jumpMultiplier);

   this.velocity.clampLength(0,this.data.maxSpeed);
  } else {
   this.velocity.y+=this.data.gravity*dt;
   this.rigPos.addScaledVector(this.velocity,dt);
  }

  if(this.rigPos.y<0) {
   this.rigPos.y=0;
   this.velocity.y=0;

   if(!isPushing) {
    this.velocity.x*=0.85;
    this.velocity.z*=0.85;
   }
  }
 }
});


// ========================================
// BALL SPINNER
// ========================================

AFRAME.registerComponent('ball-spin',{
 tick:function(t,dt) {
  this.el.object3D.rotation.x+=dt*0.0005;
  this.el.object3D.rotation.y+=dt*0.001;
 }
});


// ========================================
// DECORATIVE BOUNCE
// ========================================

AFRAME.registerComponent('floating',{
 schema:{speed:{default:1}},
 init:function() {
  this.startY=this.el.object3D.position.y;
 },
 tick:function(t) {
  this.el.object3D.position.y=
   this.startY+Math.sin(t*0.001*this.data.speed)*0.12;
 }
});

</script>


<a-scene
 background="color: #87CEEB"
 shadow="type: pcfsoft"
 renderer="antialias: true"
 vr-mode-ui="enabled: true"
>

<a-assets>
 <a-mixin id="wood" material="color:#795548; roughness:1"></a-mixin>
 <a-mixin id="leaf" material="color:#236b38; roughness:1"></a-mixin>
</a-assets>


<!-- ================================== -->
<!-- LIGHTING -->
<!-- ================================== -->

<a-light type="ambient" color="#ffffff" intensity="0.8"></a-light>

<a-light
 type="directional"
 position="-5 10 5"
 intensity="1.5"
 cast-shadow="true">
</a-light>


<!-- ================================== -->
<!-- PLAYER RIG -->
<!-- ================================== -->

<a-entity
 id="player"
 position="0 0 5"
 gorilla-locomotion="
  leftHand:#left-hand;
  rightHand:#right-hand;
  gravity:-9.8;
  jumpMultiplier:1.3;
  maxSpeed:12;
  handRadius:0.12">

 <a-camera position="0 1.6 0"
  look-controls="enabled:true"
  wasd-controls="enabled:false">
 </a-camera>

 <!-- LEFT VR HAND -->

 <a-entity
  id="left-hand"
  hand-controls="hand:left; handModelStyle:lowPoly; color:#ff5555">

  <a-sphere
   radius="0.10"
   color="#ff5555"
   material="roughness:0.5">
  </a-sphere>

 </a-entity>

 <!-- RIGHT VR HAND -->

 <a-entity
  id="right-hand"
  hand-controls="hand:right; handModelStyle:lowPoly; color:#5555ff">

  <a-sphere
   radius="0.10"
   color="#5555ff"
   material="roughness:0.5">
  </a-sphere>

 </a-entity>

</a-entity>


<!-- ================================== -->
<!-- MONKEY PLAYER MODEL -->
<!-- ================================== -->

<a-entity id="monkey" position="0 0 2">

 <!-- BODY -->

 <a-sphere
  position="0 0.9 0"
  radius="0.48"
  scale="0.85 1.15 0.75"
  color="#7b4b2c"
  roughness="1">
 </a-sphere>

 <!-- BELLY -->

 <a-sphere
  position="0 0.9 -0.27"
  radius="0.32"
  scale="0.85 1.1 0.35"
  color="#d8a477">
 </a-sphere>

 <!-- HEAD -->

 <a-sphere
  position="0 1.85 0"
  radius="0.48"
  color="#87512e">
 </a-sphere>

 <!-- FACE -->

 <a-sphere
  position="0 1.76 -0.37"
  radius="0.27"
  scale="1 0.75 0.55"
  color="#d6a078">
 </a-sphere>

 <!-- EYES -->

 <a-sphere
  position="-0.17 1.98 -0.40"
  radius="0.075"
  color="white">
 </a-sphere>

 <a-sphere
  position="0.17 1.98 -0.40"
  radius="0.075"
  color="white">
 </a-sphere>

 <!-- PUPILS -->

 <a-sphere
  position="-0.17 1.98 -0.465"
  radius="0.035"
  color="#111111">
 </a-sphere>

 <a-sphere
  position="0.17 1.98 -0.465"
  radius="0.035"
  color="#111111">
 </a-sphere>

 <!-- NOSE -->

 <a-sphere
  position="0 1.79 -0.53"
  radius="0.07"
  scale="1.2 0.7 0.6"
  color="#493027">
 </a-sphere>

 <!-- MOUTH -->

 <a-torus
  position="0 1.65 -0.48"
  radius="0.09"
  radius-tubular="0.018"
  arc="180"
  rotation="0 0 180"
  color="#392018">
 </a-torus>

 <!-- ARMS -->

 <a-cylinder
  position="-0.58 0.95 0"
  rotation="0 0 45"
  radius="0.17"
  height="0.85"
  color="#7b4b2c">
 </a-cylinder>

 <a-cylinder
  position="0.58 0.95 0"
  rotation="0 0 -45"
  radius="0.17"
  height="0.85"
  color="#7b4b2c">
 </a-cylinder>

 <!-- LEGS -->

 <a-cylinder
  position="-0.23 0.27 0"
  radius="0.16"
  height="0.55"
  color="#60391f">
 </a-cylinder>

 <a-cylinder
  position="0.23 0.27 0"
  radius="0.16"
  height="0.55"
  color="#60391f">
 </a-cylinder>

 <!-- TAIL -->

 <a-torus
  position="0 0.55 0.55"
  rotation="90 0 0"
  radius="0.3"
  radius-tubular="0.09"
  color="#7b4b2c">
 </a-torus>

</a-entity>


<!-- ================================== -->
<!-- WORLD FLOOR -->
<!-- ================================== -->

<a-plane
 class="collidable"
 position="0 0 0"
 rotation="-90 0 0"
 width="50"
 height="50"
 color="#378a42"
 shadow="receive:true">
</a-plane>


<!-- ================================== -->
<!-- CLIMBING PLATFORMS -->
<!-- ================================== -->

<a-box class="collidable"
 position="0 0.75 -2"
 width="2" height="1.5" depth="1"
 color="#8D6E63">
</a-box>

<a-box class="collidable"
 position="2.5 1.5 -3"
 width="1" height="3" depth="4"
 color="#795548">
</a-box>

<a-box class="collidable"
 position="-2.5 1.5 -3"
 width="1" height="3" depth="4"
 color="#795548">
</a-box>

<a-box class="collidable"
 position="0 3 -7"
 width="5" height="0.5" depth="3"
 color="#795548">
</a-box>

<a-box class="collidable"
 position="5 2 -8"
 width="3" height="0.5" depth="3"
 color="#8D6E63">
</a-box>

<a-box class="collidable"
 position="-5 2 -8"
 width="3" height="0.5" depth="3"
 color="#8D6E63">
</a-box>

<a-box class="collidable"
 position="0 4 -12"
 width="4" height="0.5" depth="4"
 color="#795548">
</a-box>


<!-- ================================== -->
<!-- TREES -->
<!-- ================================== -->

<script>
const scene=document.querySelector('a-scene');

function makeTree(x,z,h) {
 const trunk=document.createElement('a-cylinder');
 trunk.setAttribute('position',`${x} ${h/2} ${z}`);
 trunk.setAttribute('radius','0.3');
 trunk.setAttribute('height',h);
 trunk.setAttribute('color','#684025');
 scene.appendChild(trunk);

 for(let i=0;i<3;i++) {
  const leaves=document.createElement('a-sphere');
  leaves.setAttribute('position',
   `${x} ${h+i*0.55} ${z}`);
  leaves.setAttribute('radius',`${1.1-i*.15}`);
  leaves.setAttribute('color',
   i===0?'#164d29':'#267a38');
  scene.appendChild(leaves);
 }
}

for(let i=0;i<35;i++) {
 const x=(Math.random()-.5)*35;
 const z=(Math.random()-.5)*35;

 if(Math.abs(x)<4 && Math.abs(z)<4) continue;

 makeTree(x,z,3+Math.random()*2);
}
</script>


<!-- ================================== -->
<!-- PICKUP-STYLE BALLS / DECORATION -->
<!-- ================================== -->

<a-sphere
 position="2 0.5 1"
 radius="0.35"
 color="#ff3333"
 ball-spin
 floating>
</a-sphere>

<a-sphere
 position="-2 0.5 0"
 radius="0.35"
 color="#3399ff"
 ball-spin
 floating>
</a-sphere>

<a-sphere
 position="4 0.5 -5"
 radius="0.35"
 color="#ffff33"
 ball-spin
 floating>
</a-sphere>

<a-sphere
 position="-4 0.5 -5"
 radius="0.35"
 color="#bb44ff"
 ball-spin
 floating>
</a-sphere>


<!-- ================================== -->
<!-- SKY DECORATION -->
<!-- ================================== -->

<a-sphere
 position="0 15 -25"
 radius="4"
 color="#fff1a6"
 material="shader:flat">
</a-sphere>

<a-sky color="#87CEEB"></a-sky>

</a-scene>

</body>
</html>
